  "dogecoin.org": {
    "home": {
      "about": {
        "hero": {
          "title": "Acerca de la fundación",
          "intro": "La Fundación Dogecoin es una organización sin fines de lucro establecida para proporcionar:",
          "bulletPoints": [
            "Apoyo a la criptomoneda Dogecoin mediante desarrollo y promoción.",
            "Defensa de la marca Dogecoin para prevenir abusos y fraudes.",
            "Una hoja de ruta para el futuro de Dogecoin."
          ]
        },
        "manifesto": {
          "title": "El Manifiesto Dogecoin",
          "intro": "Somos Dogecoin, el movimiento cripto accidental que hace sonreír a la gente.\n[space]\n[small]Estamos desarrollando una moneda para la gente,[/small]\n[small]y nos esforzamos por hacer solo el bien cada día.[/small]\n[small]A través de este trabajo hemos llegado a valorar:[/small]\n[space]\n[gray]Siendo[/gray] [bold]útiles[/bold][gray], valoramos[/gray] la utilidad [gray]por encima del[/gray] brillo técnico.\n[gray]Siendo[/gray] [bold]personales[/bold][gray], valoramos[/gray] a los individuos y las interacciones [gray]por encima de[/gray] la economía impulsada por el lucro.\n[gray]Siendo[/gray] [bold]acogedores[/bold][gray], valoramos[/gray] la colaboración y la confianza [gray]por encima de[/gray] la competencia y la exclusividad.\n[gray]Siendo[/gray] [bold]confiables[/bold][gray], valoramos[/gray] las soluciones funcionales [gray]por encima de[/gray] la velocidad de entrega.\n[space]\n[small]Es decir, aunque hay valor en los elementos de la derecha,[/small]\n[small]valoramos más los elementos de la izquierda.[/small]",
          "cards": [
            {
              "title": "Ser útil",
              "text": "Valoramos la utilidad por encima del brillo técnico."
            },
            {
              "title": "Ser personal",
              "text": "Valoramos a los individuos y las interacciones por encima de la economía impulsada por el lucro."
            },
            {
              "title": "Ser acogedor",
              "text": "Valoramos la colaboración y la confianza por encima de la competencia y la exclusividad."
            },
            {
              "title": "Ser confiable",
              "text": "Valoramos soluciones que funcionan por encima de la velocidad de entrega."
            }
          ],
          "signatoriesTitle": "Firmantes",
          "sign": {
            "title": "Firma el manifiesto",
            "text": "Puedes firmar el Manifiesto Dogecoin en X",
            "button": "Publicar"
          }
        },
        "history": {
          "title": "Nuestra historia",
          "description": "La Fundación fue establecida por miembros del equipo de Dogecoin en 2014 para apoyar y defender el proyecto. Creado en diciembre de 2013 por Billy Markus y Jackson Palmer como una alternativa divertida a Bitcoin, Dogecoin se inspiró en el meme \"Doge\" y rápidamente ganó una comunidad fuerte conocida por esfuerzos caritativos, como financiar al equipo jamaicano de bobsleigh y Doge4Water.",
          "description2": "A medida que el interés fluctuó, la Fundación se volvió menos activa pero fue revivida en 2021 por miembros originales, nuevas caras y asesores como Vitalik Buterin de Ethereum y Jared Birchall de Neuralink. El renacimiento tuvo como objetivo asegurar financiación, proporcionar dirección estratégica y garantizar el crecimiento a largo plazo de Dogecoin."
        }
      },
