  "dogecoin.org": {
    "home": {
      "about": {
        "hero": {
          "title": "关于基金会",
          "intro": "狗狗币基金会是一家非营利组织，成立目的是提供：",
          "bulletPoints": [
            "通过开发与倡导支持狗狗币加密货币。",
            "维护狗狗币商标，防止滥用与欺诈。",
            "制定狗狗币的未来路线图。"
          ]
        },
        "manifesto": {
          "title": "狗狗币宣言",
          "intro": "我们是狗狗币，这个让人们微笑的意外加密运动。\n[space]\n[small]我们正在为人们打造一种货币，[/small]\n[small]并努力每天只做善事。[/small]\n[small]通过这项工作，我们逐渐重视：[/small]\n[space]\n[gray]务实[/gray][bold]有用[/bold][gray]，我们更重视[/gray]实用性[gray]而非[/gray]技术上的炫目。\n[gray]真诚[/gray][bold]亲切[/bold][gray]，我们更重视[/gray]个人与互动[gray]，而非以[/gray]利润驱动的经济。\n[gray]开放[/gray][bold]包容[/bold][gray]，我们更重视[/gray]协作与信任[gray]，而非[/gray]竞争与排他。\n[gray]可靠[/gray][bold]可信[/bold][gray]，我们更重视[/gray]可用的解决方案[gray]，而非[/gray]交付的速度。\n[space]\n[small]也就是说，虽然右边的项目也有价值，[/small]\n[small]但我们更重视左边的项目。[/small]",
          "cards": [
            {
              "title": "务实有用",
              "text": "我们更重视实用性而非技术上的炫目。"
            },
            {
              "title": "真诚亲切",
              "text": "我们更重视个人与互动，而非以利润驱动的经济。"
            },
            {
              "title": "开放包容",
              "text": "我们更重视协作与信任，而非竞争与排他。"
            },
            {
              "title": "可靠可信",
              "text": "我们更重视可用的解决方案，而非交付的速度。"
            }
          ],
          "signatoriesTitle": "签署者",
          "sign": {
            "title": "签署宣言",
            "text": "你可以在 X 上签署狗狗币宣言",
            "button": "发布"
          }
        },
        "history": {
          "title": "我们的历史",
          "description": "基金会由狗狗币团队成员于 2014 年成立，旨在支持并倡导该项目。狗狗币由 Billy Markus 与 Jackson Palmer 于 2013 年 12 月创建，作为比特币的有趣替代方案，灵感来源于\"Doge\"表情包，并迅速收获了以慈善闻名的强大社区，如资助牙买加雪车队与 Doge4Water。",
          "description2": "随着兴趣起伏，基金会一度不太活跃，但在 2021 年由早期成员、新面孔及顾问（如以太坊的 Vitalik Buterin 与 Neuralink 的 Jared Birchall）共同复兴，旨在确保资金、提供战略方向，并确保狗狗币的长期发展。"
        }
      },
      "meta": {
        "title": "狗狗币基金会 - 每天只做善事",
        "description": "狗狗币基金会的官方网站。了解我们的项目、社区倡议以及如何支持狗狗币生态系统。"
      },
      "hero": {
        "title": "ÐOGECOIN",
        "subtitle": "基金会",
        "tagline": "每天只做善事"
      },
      "sections": {
        "activity": {
          "title": "很多活动"
        },
        "mission": {
          "title": "此类使命",
          "description": "我们的使命是推广狗狗币作为一个有趣、易用且包容的加密货币的发展与采用。",
          "cards": [
            {
              "title": "可访问性",
              "description": "让所有人都能使用加密货币，无论技术背景或财务状况如何。"
            },
            {
              "title": "社区",
              "description": "建立和培育一个强大、包容的社区，互相支持并传播善意。"
            },
            {
              "title": "创新",
              "description": "在保持简洁性和可用性的同时推动区块链技术的创新。"
            },
            {
              "title": "教育",
              "description": "提供教育资源来帮助人们理解和安全地使用加密货币。"
            },
            {
              "title": "慈善",
              "description": "支持让世界变得更美好的慈善事业和社区倡议。"
            },
            {
              "title": "透明度",
              "description": "在我们所有的运营和决策过程中保持透明。"
            },
            {
              "title": "可持续性",
              "description": "确保狗狗币生态系统的长期可持续性和增长。"
            },
            {
              "title": "乐趣",
              "description": "保持让狗狗币独特且令人愉悦的有趣和轻松精神。"
            }
          ]
        },
