  "dogecoin.org": {
    "home": {
      "about": {
        "hero": {
          "title": "Informazioni sulla fondazione",
          "intro": "La Dogecoin Foundation è un'organizzazione senza scopo di lucro istituita per fornire:",
          "bulletPoints": [
            "Supporto alla criptovaluta Dogecoin attraverso sviluppo e advocacy.",
            "Difesa del marchio Dogecoin per prevenire abusi e frodi.",
            "Una roadmap per il futuro di Dogecoin."
          ]
        },
        "manifesto": {
          "title": "Il Manifesto Dogecoin",
          "intro": "Siamo Dogecoin, il movimento crypto accidentale che fa sorridere le persone.\n[space]\n[small]Stiamo sviluppando una valuta per le persone,[/small]\n[small]e ci impegniamo a fare solo il bene ogni giorno.[/small]\n[small]Attraverso questo lavoro siamo arrivati a valorizzare:[/small]\n[space]\n[gray]Essere[/gray] [bold]utili[/bold][gray], valorizziamo l'[/gray]utilità [gray]rispetto al[/gray] brillante tecnicismo.\n[gray]Essere[/gray] [bold]cordiali[/bold][gray], valorizziamo[/gray] individui e interazioni [gray]rispetto a un'[/gray]economia guidata dal profitto.\n[gray]Essere[/gray] [bold]accoglienti[/bold][gray], valorizziamo[/gray] collaborazione e fiducia [gray]rispetto a[/gray] competizione ed esclusività.\n[gray]Essere[/gray] [bold]affidabili[/bold][gray], valorizziamo[/gray] soluzioni funzionanti [gray]rispetto alla[/gray] velocità di consegna.\n[space]\n[small]Cioè, mentre c'è valore negli elementi a destra,[/small]\n[small]valorizziamo di più gli elementi a sinistra.[/small]",
          "cards": [
            {
              "title": "Essere utili",
              "text": "Valorizziamo l'utilità rispetto al brillante tecnicismo."
            },
            {
              "title": "Essere cordiali",
              "text": "Valorizziamo individui e interazioni rispetto a un'economia guidata dal profitto."
            },
            {
              "title": "Essere accoglienti",
              "text": "Valorizziamo collaborazione e fiducia rispetto a competizione ed esclusività."
            },
            {
              "title": "Essere affidabili",
              "text": "Valorizziamo soluzioni funzionanti rispetto alla velocità di consegna."
            }
          ],
          "signatoriesTitle": "Firmatari",
          "sign": {
            "title": "Firma il manifesto",
            "text": "Puoi firmare il Manifesto Dogecoin su X",
            "button": "Pubblica"
          }
        },
        "history": {
          "title": "La nostra storia",
          "description": "La Fondazione è stata istituita nel 2014 dai membri del team Dogecoin per supportare e promuovere il progetto. Creato nel dicembre 2013 da Billy Markus e Jackson Palmer come alternativa divertente a Bitcoin, Dogecoin è stato ispirato dal meme \"Doge\" e ha rapidamente guadagnato una forte comunità nota per gli sforzi caritatevoli, come il finanziamento della squadra giamaicana di bob e Doge4Water.",
          "description2": "Con l'altalena dell'interesse, la Fondazione è diventata meno attiva ma è stata rilanciata nel 2021 da membri originali, nuovi volti e consulenti come Vitalik Buterin (Ethereum) e Jared Birchall (Neuralink). Il rilancio mirava a garantire finanziamenti, fornire direzione strategica e assicurare la crescita a lungo termine di Dogecoin."
        }
      },
      "meta": {
        "title": "Dogecoin Foundation - Fai Solo Bene Ogni Giorno",
        "description": "Il sito ufficiale della Dogecoin Foundation. Scopri i nostri progetti, le iniziative della comunità e come supportare l'ecosistema Dogecoin."
      },
      "hero": {
        "subtitle": "Fondazione",
        "tagline": "Fai Solo Bene Ogni Giorno"
      },
      "sections": {
        "activity": {
          "title": "Molta attività"
        },
        "mission": {
          "title": "Tale Missione",
          "description": "La nostra missione è promuovere lo sviluppo e l'adozione di Dogecoin come una criptovaluta divertente, accessibile e inclusiva.",
          "cards": [
            {
              "title": "Accessibilità",
              "description": "Rendere la criptovaluta accessibile a tutti, indipendentemente dal background tecnico o dalla situazione finanziaria."
            },
            {
              "title": "Comunità",
              "description": "Costruire e coltivare una comunità forte e inclusiva che si sostiene a vicenda e diffonde gentilezza."
            },
            {
              "title": "Innovazione",
              "description": "Guidare l'innovazione nella tecnologia blockchain mantenendo semplicità e usabilità."
            },
            {
              "title": "Educazione",
              "description": "Fornire risorse educative per aiutare le persone a comprendere e utilizzare le criptovalute in sicurezza."
            },
            {
              "title": "Carità",
              "description": "Sostenere cause benefiche e iniziative comunitarie che rendono il mondo un posto migliore."
            },
            {
              "title": "Trasparenza",
              "description": "Mantenere la trasparenza in tutte le nostre operazioni e processi decisionali."
            },
            {
              "title": "Sostenibilità",
              "description": "Garantire la sostenibilità a lungo termine e la crescita dell'ecosistema Dogecoin."
            },
            {
              "title": "Divertimento",
              "description": "Mantenere lo spirito divertente e spensierato che rende Dogecoin unico e piacevole."
            }
          ]
